# Copy this file to .env and adjust the values for your machine/team.
# The API server loads .env automatically when you run `npm run server`.
# The frontend (Vite) also reads VITE_* variables from .env automatically.

# --- Server ---
PORT=3001
NODE_ENV=development
# Set once and keep unchanged so sessions and membership QR codes survive API restarts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Server-only credentials for initial admin setup and the admin:password command.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ESP32-CAM device authentication. Keep this out of VITE_* variables and Git.
# Use at least 32 random characters; set the same value in the device's secrets.h.
SCANNER_API_KEY=
SCANNER_DEVICE_ID=entrance-esp32-cam

# Base URL the password-reset email links to (the frontend origin).
CLIENT_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# FitPulse uses this SMTP transport for password resets and membership reminders.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Frontend ---
# Vite forwards /api to the local Node server, including through ngrok.
# For a separately hosted API, set its HTTPS URL at build time when deploying.
VITE_API_URL=/api

# Apply supabase/migrations/001_fitpulse_database.sql in the Supabase SQL Editor.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Server-side key only. Never rename this to a VITE_* variable or expose it to the browser.
SUPABASE_SECRET_KEY=replace_with_your_server_secret
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Face verification is used for enrollment and enrolled administrators. Apply migrations 002, 009,
# 010, 011 and 012, then set a stable 32-byte key generated with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the same key backed up securely; losing it makes saved templates unreadable.
# The flag only controls optional face verification for enrolled staff accounts.
FACE_LOGIN_ENABLED=false
FACE_ENCRYPTION_KEY=

# TESTING ONLY. Never set to false in production.
# Verification defaults ON. Only the exact value false disables it outside production.
# Set the Vite flag at build time; never expose encryption keys as VITE_ variables.
ID_VERIFICATION_ENABLED=false
VITE_ID_VERIFICATION_ENABLED=false

# Stable 32-byte hex key for member ID encryption and duplicate detection.
# If left empty, the server uses FACE_ENCRYPTION_KEY. Keep the chosen key stable.
ID_VERIFICATION_KEY=
# Private PaddleOCR General OCR endpoint for independent server-side ID verification.
ID_PADDLE_OCR_URL=http://127.0.0.1:8080/ocr
# Optional public directory for the browser's two PP-OCRv5 model archives.
# Without it, PaddleOCR.js downloads the archives from Paddle's model host.
VITE_ID_OCR_MODEL_DIRECTORY=
# Optional full path to Poppler's pdftoppm executable. If empty, uses PATH.
ID_PDF_RENDERER=

#
