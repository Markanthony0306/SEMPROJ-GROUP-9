# Copy this file to .env and adjust the values for your machine/team.
# The API server loads .env automatically when you run `npm run server`.
# The frontend (Vite) also reads VITE_* variables from .env automatically.

# --- Server ---
PORT=3001
NODE_ENV=development
# Required in production (NODE_ENV=production). Use a long random string.
JWT_SECRET=
# Used to create the first administrator on a fresh database (required in production).
ADMIN_PASSWORD=

# Base URL the password-reset email links to (the frontend origin).
CLIENT_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Email (optional). Without SMTP, reset links print to the server console in dev only. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FitPulse <no-reply@fitpulse.local>

# --- Frontend ---
# Where the browser reaches the API. Set this at build time when deploying.
VITE_API_URL=http://localhost:3001/api